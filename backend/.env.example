# AeroSense AI — Environment Configuration Template
# Copy this file to .env in your root directory and/or backend directory

# 1. Google Gemini API Key (COMPULSORY for GenAI Assistant & Contextual Environmental Briefings)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. World Air Quality Index (WAQI) Token (Primary Ground Station Observation Provider)
# Obtain an instant free token in 10 seconds: https://aqicn.org/data-platform/token/
WAQI_API_KEY=your_waqi_api_token_here

# 3. OpenAQ API v3 Key (Optional secondary ground sensor provider)
# Register at: https://explore.openaq.org/register
OPENAQ_API_KEY=

# 4. Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=aerosense-production-secret-key-change-me-for-custom-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 5. Database Configuration (PostgreSQL / Neon or SQLite)
# Production PostgreSQL (Neon Serverless, AWS RDS, Supabase, etc.):
# For Neon, paste your direct connection string (Pooling OFF, SSL Required).
# AeroSense AI automatically converts postgresql:// to postgresql+asyncpg:// and injects SSL.
# Example:
# DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Local Development (Default SQLite):
DATABASE_URL=sqlite+aiosqlite:///./aerosense.db

# 6. Environment & CORS
ENVIRONMENT=development
DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
