# AeroSense AI - Environment Configuration
# Copy this file to .env or edit directly

# 1. Google Gemini API Key (Required for full Gemini LLM conversational reasoning)
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. OpenAQ API v3 Key (Optional - for direct ground sensor station ingestion)
# Register and get your free key from: https://explore.openaq.org/register
OPENAQ_API_KEY=

# 3. Security & Database Settings (Defaults are pre-configured)
SECRET_KEY=aerosense-production-secret-key-change-me-for-custom-deployment
DATABASE_URL=sqlite+aiosqlite:///./aerosense.db
